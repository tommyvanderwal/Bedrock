#cloud-config
hostname: {HOSTNAME}
fqdn: {HOSTNAME}.bedrock.local
manage_etc_hosts: true

# Don't grow the root partition to fill the disk. We deliberately leave
# the unallocated tail of /dev/vda free so bedrock-bootstrap can carve
# /dev/vda5 there as the LVM PV for the bedrock VG (single-disk-one-VG
# storage model). Without these flags, cloud-init's growpart + resizefs
# would extend vda4 to the entire disk and there'd be no room left.
growpart:
  mode: false
resize_rootfs: false

users:
  - name: root
    lock_passwd: false
    hashed_passwd: "{ROOT_PASSWD_HASH}"
    ssh_authorized_keys:
      - {SSH_PUBKEY}

ssh_pwauth: true
disable_root: false

write_files:
  # br0 takes the LAN address directly (no DHCP) — the home router is
  # the only DHCP server on the network. Static + reserved-by-design
  # makes spawn.py's IP discovery deterministic and avoids LAN
  # collisions. eth0 is the bridge port (no IP of its own).
  - path: /etc/NetworkManager/system-connections/br0.nmconnection
    permissions: '0600'
    content: |
      [connection]
      id=br0
      type=bridge
      interface-name=br0
      autoconnect=true
      # See br0-eth0 comment below — same priority bump applied so
      # the bridge wins over any cloud-init auto-generated DHCP
      # connection.
      autoconnect-priority=200

      [bridge]
      stp=false

      [ipv4]
      method=manual
      addresses={MGMT_IP}/24
      gateway={MGMT_GATEWAY}
      dns={MGMT_DNS}
      dns-search=

      [ipv6]
      method=disabled

  - path: /etc/NetworkManager/system-connections/br0-eth0.nmconnection
    permissions: '0600'
    content: |
      [connection]
      id=br0-eth0
      type=ethernet
      interface-name=eth0
      master=br0
      slave-type=bridge
      autoconnect=true
      # autoconnect-priority must beat cloud-init's auto-generated
      # `cloud-init eth0` connection (priority 120). Without this,
      # the race at NetworkManager startup non-deterministically
      # picks cloud-init's DHCP-on-standalone-eth0 over our
      # br0-eth0 bridge slave — eth0 ends up unmanaged by br0 and
      # br0 sits NO-CARRIER with the intended static IP unreachable.
      # See lessons-log L44 for the full RCA.
      autoconnect-priority=200

  - path: /etc/NetworkManager/system-connections/bedrock-drbd.nmconnection
    permissions: '0600'
    content: |
      [connection]
      id=bedrock-drbd
      type=ethernet
      interface-name=eth1
      autoconnect=true

      [ipv4]
      method=manual
      addresses={DRBD_IP}/24
      dns-search=

      [ipv6]
      method=disabled

  - path: /etc/hosts
    append: true
    content: |
      # Bedrock testbed nodes
{HOSTS_ENTRIES}

runcmd:
  - nmcli con delete "Wired connection 1" 2>/dev/null || true
  # Delete cloud-init's own auto-generated DHCP-eth0 connection.
  # It has autoconnect-priority=120 and competes with br0-eth0 for
  # eth0. Without this delete, NetworkManager may activate it on
  # boot ordering races and leave br0 NO-CARRIER. The autoconnect-
  # priority=200 on br0-eth0 is the primary defence; this is the
  # secondary one. See lessons-log L44.
  - nmcli con delete "cloud-init eth0" 2>/dev/null || true
  - systemctl restart NetworkManager
  - sleep 2
  - nmcli con up br0 || true
  - nmcli con up br0-eth0 || true
  - nmcli con up bedrock-drbd || true
  - setenforce 0 || true
  - sed -i 's/^SELINUX=.*/SELINUX=permissive/' /etc/selinux/config
  - systemctl disable --now firewalld 2>/dev/null || true
  - echo "Bedrock testbed node {HOSTNAME} ready" > /etc/motd
