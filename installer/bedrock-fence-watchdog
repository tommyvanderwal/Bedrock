#!/bin/bash
# bedrock-fence-watchdog — independent of bedrock-mgmt.
#
# Reboots the node if /run/bedrock-cluster.fence has been present for
# longer than MAX_AGE seconds. Runs every 30 s as a systemd timer.
# Does NOT depend on bedrock-mgmt being alive — that's the whole
# point. If mgmt's fence_responder crashes mid-cleanup, this is what
# eventually gets the node back to a known state.
#
# Reboot is the safety-net cleanup. In the happy path (mgmt cleans
# up + unfences within ~30 s), this script never sees a stale marker.
set -u

MARKER=/run/bedrock-cluster.fence
MAX_AGE=300   # 5 minutes — aligns with AD/Kerberos TGT renewal

[ -f "$MARKER" ] || exit 0

now=$(date +%s)
mtime=$(stat -c %Y "$MARKER" 2>/dev/null) || exit 0
age=$(( now - mtime ))

if [ "$age" -gt "$MAX_AGE" ]; then
    logger -t bedrock-fence-watchdog \
        "fence marker age ${age}s > ${MAX_AGE}s — initiating reboot"
    /bin/systemctl reboot
fi
