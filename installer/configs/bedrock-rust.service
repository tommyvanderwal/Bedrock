[Unit]
Description=Bedrock cluster-protocol daemon (Rust)
After=network-online.target
Wants=network-online.target
# bedrock-mgmt depends on the IPC socket from this daemon to be up.

[Service]
Type=simple
ExecStart=/usr/local/bin/bedrock-rust --log-dir /var/lib/bedrock/log --ipc-sock /run/bedrock-rust.sock daemon --config /etc/bedrock/daemon.toml
Restart=on-failure
RestartSec=5
# Daemon does ip-link manipulation on self-fence and writes the fence
# marker / role file. On fence the daemon does NOT exit — it stays
# running and idles until bedrock-mgmt has cleaned up + cleared the
# marker. Run as root for ip-link + /run/* writes.
User=root
Group=root
# Avoid log noise from RUST_BACKTRACE on every restart.
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
