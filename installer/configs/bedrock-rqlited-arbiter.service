[Unit]
Description=Bedrock cluster-state store — ARBITER rqlite (D-04)
Documentation=https://rqlite.io/ https://github.com/tommyvanderwal/Bedrock
# The arbiter only starts AFTER the per-node rqlite is up AND the
# tier-cluster DRBD volume is mounted with the arbiter's data dir
# accessible. cluster_arbiter.py's promote_to_arbiter_host() drives
# the actual sequencing — this unit is started by that script, not
# enabled standalone.
After=network-online.target bedrock-d.service bedrock-rqlited.service
Wants=network-online.target
# Allow several restarts during master-role transitions before
# systemd gives up — each transition demotes-then-promotes which
# can produce a quick stop/start.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=/etc/bedrock/rqlited-arbiter.env

# Refuse to run if cluster_arbiter.py says we're not the
# hosting node (DRBD secondary, no mount, no .254 on lo).
# cluster_arbiter.py's promote_to_arbiter_host() puts everything
# in place; this guard catches "operator manually started the
# unit on a non-leader" mistakes.
ExecStartPre=/usr/bin/python3 -c "import sys; sys.path.insert(0, '/usr/local/lib/bedrock'); from lib import cluster_arbiter as a; s = a.arbiter_status(); sys.exit(0 if (s['drbd_role'] == 'Primary' and s['mounted'] and s['ip_present']) else 1)"

# /bin/sh -c so multi-word env values get word-split. rqlite v10:
# on-disk is the only mode; no -on-disk flag needed.
#
# Ports: the arbiter uses 4011/4012 so it can coexist with the
# per-node rqlited (which binds 0.0.0.0:4001/4002) on the same host.
# The .254/32 advertised address keeps peers routing to whichever
# node currently holds the master role.
ExecStart=/bin/sh -c '/usr/local/bin/rqlited \
    -node-id "$BEDROCK_ARBITER_NODE_ID" \
    -http-addr "$BEDROCK_ARBITER_BIND_IP:4011" \
    -raft-addr "$BEDROCK_ARBITER_BIND_IP:4012" \
    -http-adv-addr "$BEDROCK_ARBITER_BIND_IP:4011" \
    -raft-adv-addr "$BEDROCK_ARBITER_BIND_IP:4012" \
    -raft-election-timeout 2s \
    -raft-leader-lease-timeout 1s \
    -http-cert /var/lib/bedrock/cluster/ca/arbiter.crt \
    -http-key /var/lib/bedrock/cluster/ca/arbiter.key.pem \
    -http-ca-cert /var/lib/bedrock/cluster/ca/ca.crt \
    -http-verify-client \
    -node-cert /var/lib/bedrock/cluster/ca/arbiter.crt \
    -node-key /var/lib/bedrock/cluster/ca/arbiter.key.pem \
    -node-ca-cert /var/lib/bedrock/cluster/ca/ca.crt \
    -node-verify-client \
    $BEDROCK_ARBITER_JOIN_FLAG \
    $BEDROCK_ARBITER_BOOTSTRAP_FLAG \
    "$BEDROCK_ARBITER_DATA_DIR"'

Restart=on-failure
RestartSec=3s

# Arbiter is a 3rd voter; doesn't carry much state. Cap RAM lower
# than the per-node unit since arbiter shouldn't have a large
# working set.

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Arbiter writes its WAL + snapshot under the tier-cluster mount.
# /etc/bedrock for the env file that cluster_arbiter.py renders.
ReadWritePaths=/var/lib/bedrock/cluster /etc/bedrock

StandardOutput=journal
StandardError=journal

# NOT enabled by default — cluster_arbiter.py starts/stops this
# imperatively as part of the master role transition. The
# orchestrator's revision-watcher invokes converge() on every
# revision change.
[Install]
WantedBy=
