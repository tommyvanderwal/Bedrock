[Unit]
Description=Bedrock mesh network daemon (path discovery + routing)
Documentation=man:bedrock-net(8) https://github.com/bedrockcluster/bedrock
After=network.target bedrock-rust.service
Wants=bedrock-rust.service
# We don't fail the unit if state.json isn't ready yet — the daemon
# polls cluster.json on each tick and picks up loopback_ip when it
# appears (post init/join). That makes restart loops self-healing.

[Service]
Type=simple
ExecStart=/usr/local/bin/bedrock-net
Restart=on-failure
RestartSec=2
# We touch /proc/sys/net (rp_filter), the ip route table, and need to
# bind <1024-class but not really — multicast group operations need
# CAP_NET_ADMIN; route changes need CAP_NET_ADMIN. Run as root for v1
# rather than juggle capabilities; revisit later.
StandardOutput=journal
StandardError=journal
# Environment for the python entry point — the lib path lives under
# /usr/local/lib/bedrock/lib so absolute-imports inside netd.py
# resolve when run as a script.
Environment=PYTHONPATH=/usr/local/lib/bedrock

[Install]
WantedBy=multi-user.target
