[Unit]
Description=Bedrock cluster-state store (rqlite, per-node instance)
Documentation=https://rqlite.io/ https://github.com/tommyvanderwal/Bedrock
After=network-online.target
Wants=network-online.target
# No Requires=bedrock-d here. The cluster_init / node_join sagas
# inside bedrock-d explicitly start this unit at the right step
# (after rqlited.env is rendered). Cross-Bedrock service deps
# create dependency cycles — see docs/codebase-rewrite-plan §3.5.

# Don't fight systemd's start-limit during burst inits — see
# docs/mesh-network-v1-uncertainties.md §5 for the equivalent
# bedrock-rust experience. Tunable up if needed.
StartLimitIntervalSec=60
StartLimitBurst=20

[Service]
Type=simple
# Per-node rqlite config is materialised by rqlite_setup.py into
# /etc/bedrock/rqlited.env before the service starts. The env file
# contains BEDROCK_RQLITED_NODE_ID, BEDROCK_RQLITED_BIND_IP,
# BEDROCK_RQLITED_JOIN, BEDROCK_RQLITED_DATA_DIR, and (only on
# init/bootstrap) BEDROCK_RQLITED_BOOTSTRAP_EXPECT.
EnvironmentFile=/etc/bedrock/rqlited.env

# Pre-start guard: refuse to launch if the env-file hasn't been
# rendered yet (state.json not yet present, loopback IP not yet
# assigned). rqlite_setup.py is idempotent; running it here as
# a safety net catches the boot-before-render race that the
# mesh-network rewrite-notes flagged.
ExecStartPre=/usr/bin/python3 /usr/local/lib/bedrock/lib/rqlite_setup.py --render-env

# Use /bin/sh -c so the env-var values that contain spaces
# (BEDROCK_RQLITED_JOIN_FLAG="-join host1:4002,host2:4002",
#  BEDROCK_RQLITED_BOOTSTRAP_FLAG="-bootstrap-expect 1")
# get word-split into separate argv entries. Without this,
# systemd passes each env-var value as a single token and
# rqlited rejects "-bootstrap-expect 1" as one flag.
# rqlite v10: on-disk SQLite is the only mode; no -on-disk flag.
ExecStart=/bin/sh -c '/usr/local/bin/rqlited \
    -node-id "$BEDROCK_RQLITED_NODE_ID" \
    -http-addr 0.0.0.0:4001 \
    -raft-addr 0.0.0.0:4002 \
    -http-adv-addr "$BEDROCK_RQLITED_BIND_IP:4001" \
    -raft-adv-addr "$BEDROCK_RQLITED_BIND_IP:4002" \
    -raft-election-timeout 3s \
    -raft-heartbeat-timeout 3s \
    -raft-leader-lease-timeout 1500ms \
    -raft-commit-timeout 500ms \
    -http-cert /etc/bedrock/node.crt \
    -http-key /etc/bedrock/node.key.pem \
    -http-ca-cert /etc/bedrock/ca.crt \
    -http-verify-client \
    -node-cert /etc/bedrock/node.crt \
    -node-key /etc/bedrock/node.key.pem \
    -node-ca-cert /etc/bedrock/ca.crt \
    -node-verify-client \
    $BEDROCK_RQLITED_JOIN_FLAG \
    $BEDROCK_RQLITED_BOOTSTRAP_FLAG \
    $BEDROCK_RQLITED_CDC_FLAG \
    "$BEDROCK_RQLITED_DATA_DIR"'

Restart=on-failure
RestartSec=2s
# Memory is bounded IN-PROCESS by the Go runtime (GOMEMLIMIT = soft cap;
# the GC paces to hold the heap near it, no kernel throttle). Deliberately
# NO cgroup MemoryHigh/MemoryMax — those throttle pathologically (RCA 2026-05-29).
Environment=GOMEMLIMIT=512MiB
# Loop guard — if rqlited refuses to come up repeatedly, let
# systemd's limit catch it rather than hammering forever.

# Resource bounds — rqlite at Bedrock's scale idles at ~25 MB RSS.
# Cap at 256 MB so a runaway bug can't eat the host's RAM budget
# for VMs.
# CPU is uncontended on dev boxes; leave unbounded for now.

# Filesystem isolation: rqlited only needs its data dir + the
# env file. ReadWritePaths covers the data dir AND /etc/bedrock
# (the ExecStartPre's rqlite_setup --render-env writes the env
# file there at boot when state.json has caught up).
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/bedrock/rqlite /etc/bedrock

# Logging — emit to journal; structured-logging follow-up can
# layer on top.
StandardOutput=journal
StandardError=journal

[Install]
# The per-node rqlited is the consensus FOUNDATION — it must come up at
# boot independently of bedrock-d (which READS rqlite for its election).
# Otherwise a master reboot deadlocks: an empty/lost state.json stops
# bedrock-d bootstrapping → it never starts rqlited → no rqlite → no
# recovery (observed sim-1 2026-05-29). Installed disabled; the
# cluster_init / node_join sagas `systemctl enable` this once
# rqlited.env is rendered, so it auto-starts on every later boot. The
# ExecStartPre re-renders rqlited.env from state.json each boot.
WantedBy=multi-user.target
