[Unit]
Description=SeaweedFS filer (POSIX namespace on top of volumes)
Documentation=https://github.com/seaweedfs/seaweedfs/wiki/Filer-Stores
After=network-online.target bedrock-d.service bedrock-weed-master.service bedrock-weed-volume.service
Wants=network-online.target
Requires=bedrock-d.service bedrock-weed-master.service
# NOT enabled by default — cluster_arbiter.py starts/stops this as
# part of the mgmt-master role transition (the filer SQLite DB lives
# on the tier-cluster DRBD volume, per D-07/D-10).
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=/etc/bedrock/seaweedfs.env

# Refuse to start if tier-cluster isn't mounted (the filer DB lives
# under /var/lib/bedrock/cluster/seaweedfs/).
ExecStartPre=/usr/bin/test -d /var/lib/bedrock/cluster/seaweedfs

ExecStart=/usr/local/bin/weed filer \
    -ip=${SEAWEED_LOOPBACK_IP} \
    -port=8888 \
    -port.grpc=18888 \
    -master=${SEAWEED_FILER_MASTERS}
# Filer reads /etc/seaweedfs/filer.toml from the well-known search
# paths; no `-config` flag in weed 4.25's filer subcommand.

Restart=on-failure
RestartSec=3s
MemoryHigh=192M
MemoryMax=256M

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/bedrock/cluster /etc/seaweedfs

StandardOutput=journal
StandardError=journal

# NOT WantedBy any target — cluster_arbiter.py owns the lifecycle.
[Install]
WantedBy=
