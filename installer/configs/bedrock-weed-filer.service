[Unit]
Description=SeaweedFS filer (POSIX namespace + IAM on top of volumes)
Documentation=https://github.com/seaweedfs/seaweedfs/wiki/Filer-Stores
After=network-online.target bedrock-d.service bedrock-weed-volume.service
Wants=network-online.target
# Singleton — runs on the .254/32 cluster VIP host (whoever owns
# the arbiter). cluster_arbiter.py starts/stops this as part of
# the arbiter-host role transition; filer leveldb3 lives on the
# tier-critical DRBD volume mounted at /var/lib/bedrock/cluster.
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=/etc/bedrock/seaweedfs.env

# Refuse to start if tier-critical isn't mounted (the filer DB
# lives under /var/lib/bedrock/cluster/seaweedfs/).
ExecStartPre=/usr/bin/test -d /var/lib/bedrock/cluster/seaweedfs

# Binds to the cluster VIP .254 so every node's volume + s3 reach
# the same filer endpoint regardless of which physical node hosts
# it. -peers points at the weed-master Raft-3 group.
ExecStart=/usr/local/bin/weed filer \
    -ip=${SEAWEED_FILER_VIP} \
    -ip.bind=${SEAWEED_FILER_VIP} \
    -port=8888 \
    -port.grpc=18888 \
    -master=${SEAWEED_MASTER_PEERS}
# Filer reads /etc/seaweedfs/filer.toml for the leveldb3 path; no
# `-config` flag in weed 4.25's filer subcommand.

Restart=on-failure
RestartSec=3s
MemoryHigh=192M
MemoryMax=256M

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/bedrock/cluster /etc/seaweedfs

StandardOutput=journal
StandardError=journal

# NOT WantedBy any target — cluster_arbiter.py owns the lifecycle.
[Install]
WantedBy=
