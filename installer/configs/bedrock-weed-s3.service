[Unit]
Description=SeaweedFS S3 API gateway
Documentation=https://github.com/seaweedfs/seaweedfs/wiki/AmazonS3-API
After=network-online.target bedrock-d.service
Wants=network-online.target
# Runs on EVERY node bound 0.0.0.0:8333. The filer it talks to
# lives at .254:8888 (cluster-singleton VIP), so all S3 gateways
# share one namespace + one IAM identity store. mDNS publishes
# `bedrock.local` -> any UP node for external S3 clients.
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=/etc/bedrock/seaweedfs.env

# -filer is the cluster VIP (.254/32), reachable as long as
# whichever node currently hosts the arbiter is running the filer.
# `-config` carries S3-specific knobs; IAM identities live INSIDE
# the filer DB via `-iam.filerBucketsPath=/buckets`.
ExecStart=/usr/local/bin/weed s3 \
    -filer=${SEAWEED_FILER_VIP}:8888 \
    -port=8333 \
    -ip.bind=0.0.0.0 \
    -config=/etc/bedrock/seaweedfs-s3.json

Restart=on-failure
RestartSec=3s
# Memory is bounded IN-PROCESS by the Go runtime (GOMEMLIMIT = soft cap;
# the GC paces to hold the heap near it, no kernel throttle). Deliberately
# NO cgroup MemoryHigh/MemoryMax — those throttle pathologically (RCA 2026-05-29).
Environment=GOMEMLIMIT=512MiB
Environment=GOGC=50

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=
