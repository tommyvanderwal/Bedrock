[Unit]
Description=SeaweedFS master (cluster coordinator)
Documentation=https://github.com/seaweedfs/seaweedfs/wiki
After=network-online.target bedrock-d.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
# Runs on the 3 nodes in seaweed_master_membership (Raft-3 group).
# Bound to this node's loopback /32. Not on .254 — the master
# Raft set is independent of the .254 arbiter so master availability
# doesn't depend on arbiter handovers. The calm orchestrator
# enables/disables this unit per the rqlite membership table.
# `-defaultReplication=001` makes the cluster-wide default
# 2 copies (1 extra on a different server); individual collections
# override this via `weed shell` (scratch=000, critical=002).
EnvironmentFile=/etc/bedrock/seaweedfs.env

ExecStart=/usr/local/bin/weed master \
    -ip=${SEAWEED_LOOPBACK_IP} \
    -port=9333 \
    -port.grpc=19333 \
    -mdir=/var/lib/bedrock/seaweedfs/master \
    -peers=${SEAWEED_MASTER_PEERS} \
    -defaultReplication=001 \
    -resumeState=true

Restart=on-failure
RestartSec=3s
# Memory is bounded IN-PROCESS by the Go runtime (GOMEMLIMIT = soft cap;
# the GC paces to hold the heap near it, no kernel throttle). Deliberately
# NO cgroup MemoryHigh/MemoryMax — those throttle pathologically (RCA 2026-05-29).
Environment=GOMEMLIMIT=256MiB
Environment=GOGC=50

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/bedrock/seaweedfs/master

StandardOutput=journal
StandardError=journal

# Not WantedBy any target — calm orchestrator enables on the
# Raft-3 member nodes only.
[Install]
WantedBy=
