              f"{n.get('loopback_ip',''):<16} "
              f"{n.get('role',''):<14} {m}")


def _cmd_node_leave(target: str, reason: str):
    """Cleanly remove `target` from the cluster. Run on the master.

    The master writes node_unregister to rqlite; Raft replicates it
    to every peer; each peer's view_builder folds the row out of
    cluster.json on next subscriber tick. The election layer in
    bedrock-net picks up the new membership automatically.

    The TARGET node is then asked (via SSH) to shut down its own
    bedrock services so it stops heartbeating to the witness — the
    witness's STATUS_LIST entry for that node ages out within the
    takeover threshold and the cluster never sees it again.

    Idempotent: removing a node that's already gone is a no-op append
    plus a no-op SSH (best-effort).
    """
    from lib import bedrock_state as bs, view_builder, state as _state
    s = _state.load()
    self_name = s.get("node_name", "")
    if target == self_name:
        print(f"ERROR: cannot leave-from-self. Run `bedrock node leave {target}` from another node.")
        return 1
    snapshot = view_builder.rebuild(this_node=self_name)
    target_info = (snapshot.get("nodes") or {}).get(target)
    if not target_info:
        print(f"  {target}: not in cluster snapshot — nothing to do")
        return 0

    # 1. Master writes node_unregister to rqlite. Single-writer
    #    discipline (D-20): only the mgmt master mutates; rqlite
    #    replicates via Raft.
    rev = bs.node_unregister(node_name=target, reason=reason)
    print(f"  rev={rev} node_unregister({target}, reason={reason!r})")

    # 1b. Drop the target's voter slot from rqlite's Raft membership.
    # Without this, the leaver's rqlited going offline costs a vote
    # against the live cluster, and consecutive leaves brick quorum.
    # The voter slot id = last octet of the loopback IP (per the
    # rqlite_setup loopback-octet node-id rule).
    try:
        target_lo = (target_info.get("loopback_ip") or "").rsplit(".", 1)
        if len(target_lo) == 2 and target_lo[1].isdigit():
            import subprocess as _sp_rm, json as _json_rm
            voter_id = target_lo[1]
            _sp_rm.run(
                ["curl", "-fsSL", "-X", "DELETE",
                 "http://127.0.0.1:4001/remove",
                 "-d", _json_rm.dumps({"id": voter_id})],
                capture_output=True, timeout=10,
            )
            print(f"  rqlite raft: voter id={voter_id} removed")
    except Exception as e:
        print(f"  warn: rqlite /remove failed: {e}")

    # 2. Master regenerates its own daemon.toml from the new snapshot
    #    so its peer_sender_ids drops the leaving node immediately.
    _propagate_daemon_config(f"leave:{target}")

    # 3. Best-effort: ask the leaving node to stop its bedrock
    #    services. Failure is non-fatal — the cluster has already
    #    forgotten about it; the leaving node will just stop being
    #    seen at the witness within takeover_threshold.
    target_host = target_info.get("host")
    if target_host:
        import subprocess as _sp
        rc = _sp.run([
            "ssh", "-o", "StrictHostKeyChecking=no",
            "-o", "UserKnownHostsFile=/dev/null",
            "-o", "BatchMode=yes",
            "-o", "ConnectTimeout=5",
            f"root@{target_host}",
            "systemctl stop bedrock-net bedrock-mgmt 2>/dev/null; "
            "rm -f /run/bedrock-cluster.fence; "
            "true",
        ]).returncode
        if rc != 0:
            print(f"  warn: SSH stop on {target} returned {rc} (host unreachable; "
                  f"witness will age out the entry naturally)")
        else:
            print(f"  {target}: bedrock services stopped")
    else:
        print(f"  {target}: no host on record — caller must shut it down manually")
    print(f"  cluster reduced to {len(snapshot.get(chr(110)+chr(111)+chr(100)+chr(101)+chr(115), {})) - 1} nodes")
    return 0


def _cmd_node_maint(target: str, mode: str):
    """Toggle a node's maintenance flag in rqlite. Each node's
    orchestrator watches the rqlite revision and re-renders its
    daemon.toml on change — no SSH-fanout, rqlite IS the propagation
    channel.
    """
    from lib import bedrock_state as bs
    on = (mode == "on")
    rev = bs.node_maintenance(node_name=target, on=on)
    print(f"  rev={rev} node_maintenance_set({target}, on={on})")
    print(f"  Rqlite committed; replication propagates to peers.")
    print(f"  Each node's orchestrator regenerates daemon.toml on revision change.")
    print(f"  When you take {target} offline now, surviving nodes won't fence.")


