#!/usr/bin/env python3
"""Bedrock CLI — cluster management.

Per-node commands (run on the target node):
  bedrock bootstrap        — one-time OS prep (called by install.sh)
  bedrock init             — start a new cluster (installs full mgmt stack)
  bedrock join             — join an existing cluster (agent-only)

Cluster-wide commands (run on the mgmt master unless noted):
  bedrock status           — cluster + node health
  bedrock node ...         — node operations
  bedrock vm ...           — VM operations
  bedrock storage init     — local-LV tier setup (idempotent; per-node)
  bedrock storage status   — show tier modes + mountpoints
  bedrock storage promote                       — N=1 → N=2 promotion
  bedrock storage promote-critical-3way <peer>  — N=2 → N=3 (critical tier)
  bedrock storage transfer-mgmt <new-master>    — move mgmt role
  bedrock storage remove-peer <name>            — drain + remove peer
  bedrock storage collapse-to-n1                — last-node back to standalone
"""

import argparse
import json
import os
import socket
import sys
from pathlib import Path

sys.path.insert(0, "/usr/local/lib/bedrock")
# Also support running from source tree during development
_SRC_LIB = Path(__file__).parent / "lib"
if _SRC_LIB.exists():
    sys.path.insert(0, str(_SRC_LIB.parent))


STATE_FILE = Path("/etc/bedrock/state.json")
INSTALLER_ENV = Path("/etc/bedrock/installer.env")


def load_state():
    if STATE_FILE.exists():
        return json.loads(STATE_FILE.read_text())
    return {}


def save_state(state):
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2))


def get_repo():
    """Return the repo URL (from /etc/bedrock/installer.env)."""
    if INSTALLER_ENV.exists():
        for line in INSTALLER_ENV.read_text().splitlines():
            if line.startswith("BEDROCK_REPO="):
                return line.split("=", 1)[1].strip()
    return os.environ.get("BEDROCK_REPO", "http://192.168.100.1:8000")


# ── Subcommands ────────────────────────────────────────────────────────────

def cmd_bootstrap(args):
    """One-time OS-level prep. Called right after install.sh."""
    from lib import hardware, os_setup, packages

    print("\n=== Bedrock Bootstrap ===\n")

    hw = hardware.detect()
    print(f"Node: {hw['hostname']}  ({hw['cpu_model']})")
    print(f"  vCPUs: {hw['vcpus']}  RAM: {hw['ram_mb']}MB")
    print(f"  NICs: {', '.join(n['name'] for n in hw['nics'] if n['state'] == 'UP')}")
    print(f"  Storage: {hw['root_disk_gb']}GB root disk")
    print()

    print("Installing base packages (KVM, DRBD, libvirt, exporters)...")
    packages.install_base()

    print("Configuring OS (SELinux, firewall, hostname)...")
    os_setup.configure_base(hw)

    print("Configuring networking (br0 bridge)...")
    os_setup.configure_bridge(hw)

    # Save hardware info to state
    state = load_state()
    state["hardware"] = hw
    state["bootstrap_done"] = True
    save_state(state)

    print()
    print("Bootstrap complete. Next steps:")
    print("  bedrock init             — start a new cluster")
    print("  bedrock join [--witness HOST]  — join existing cluster")
    print()


def cmd_init(args):
    """Start a new cluster as the first node."""
    from lib import mgmt_install, state as state_mod
    state = load_state()
    if not state.get("bootstrap_done"):
        print("ERROR: run `bedrock bootstrap` first.")
        return 1

    if state.get("cluster_uuid"):
        print(f"Already a member of cluster {state.get('cluster_name')}")
        return 1

    print("\n=== Bedrock Init (new cluster) ===\n")
    cluster_name = args.name or f"bedrock-{socket.gethostname()}"
    print(f"Creating cluster: {cluster_name}")

    mgmt_install.install_full(cluster_name=cluster_name, witness_host=args.witness,
                              repo=get_repo())

    state = load_state()
    print()
    print(f"Cluster {state.get('cluster_name')} initialised.")
    my_ip = state.get("mgmt_ip", "<node-ip>")
    print(f"Dashboard: http://{my_ip}:8080")
    print()


def cmd_join(args):
    """Join an existing cluster."""
    from lib import agent_install, discovery
    state = load_state()
    if not state.get("bootstrap_done"):
        print("ERROR: run `bedrock bootstrap` first.")
        return 1

    if state.get("cluster_uuid"):
        print(f"Already a member of cluster {state.get('cluster_name')}")
        return 1

    print("\n=== Bedrock Join (existing cluster) ===\n")

    witness = args.witness
    if not witness:
        print("Discovering cluster on LAN...")
        found = discovery.find_witness()
        if not found:
            print("No cluster found. Use --witness to specify manually.")
            return 1
        witness = found
        print(f"Found witness: {witness}")

    cluster_info = discovery.query_cluster(witness)
    if not cluster_info:
        print(f"Cannot get cluster info from {witness}")
        return 1

    print(f"Cluster: {cluster_info.get('cluster_name')} "
          f"({len(cluster_info.get('nodes', []))} existing nodes)")
    if not args.yes:
        ans = input("Join this cluster? [Y/n] ").strip().lower()
        if ans == "n":
            return 0

    agent_install.install(witness=witness, cluster_info=cluster_info, repo=get_repo())
    print("\nJoined. Check status with: bedrock status")


def cmd_status(args):
    """Show cluster + node status."""
    state = load_state()
    if not state:
        print("Not yet initialised. Run `bedrock bootstrap` then `bedrock init` or `bedrock join`.")
        return

    print(f"Cluster: {state.get('cluster_name', '<none>')}")
    print(f"Node:    {state.get('node_name', socket.gethostname())}")
    print(f"Role:    {state.get('role', 'compute')}")
    print(f"Mgmt IP: {state.get('mgmt_ip', '-')}")
    print(f"Witness: {state.get('witness_host', '-')}")
    print()
    # Delegate to the dashboard API if available for full cluster view
    import urllib.request
    try:
        mgmt_url = state.get("mgmt_url", f"http://{state.get('mgmt_ip', 'localhost')}:8080")
        r = urllib.request.urlopen(mgmt_url + "/api/cluster", timeout=3)
        import json as _json
        data = _json.loads(r.read())
        for name, n in data.get("nodes", {}).items():
            print(f"  {name}: online={n['online']}  vms={n.get('running_vms',[])}")
    except Exception as e:
        print(f"  (mgmt API unreachable: {e})")


def cmd_node(args):
    """Node subcommands."""
    if args.action == "list":
        _cmd_node_list()
    elif args.action == "maintenance":
        _cmd_node_maint(args.target, args.mode)
    elif args.action == "leave":
        _cmd_node_leave(args.target, getattr(args, "reason", "leave") or "leave")


def _cmd_node_list():
    """Print nodes from the materialised snapshot."""
    from lib import view_builder, state as _state
    s = _state.load()
    self_name = s.get("node_name", "")
    snapshot = view_builder.rebuild(this_node=self_name)
    nodes = snapshot.get("nodes", {}) or {}
    if not nodes:
        print("(no nodes registered yet)")
        return
    print(f"{'NAME':<35} {'HOST':<18} {'DRBD':<14} {'ROLE':<14} MAINTENANCE")
    for nm, n in nodes.items():
        m = "yes" if n.get("maintenance") else ""
        print(f"{nm:<35} {n.get('host',''):<18} {n.get('drbd_ip',''):<14} "
              f"{n.get('role',''):<14} {m}")


def _cmd_node_leave(target: str, reason: str):
    """Cleanly remove `target` from the cluster. Run on the master.

    The master appends node_unregister to the log; replication carries
    it to every peer; each peer's view_builder folds the entry → the
    target's row disappears from cluster.json on every node and from
    every node's daemon.toml peer_sender_ids list. Followers regen +
    restart their bedrock-rust automatically.

    The TARGET node is then asked (via SSH) to shut down its own
    bedrock services so it stops heartbeating to the witness — the
    witness's STATUS_LIST entry for that sender_id ages out within
    the takeover threshold and the cluster never sees it again.

    Idempotent: removing a node that's already gone is a no-op append
    plus a no-op SSH (best-effort).
    """
    from lib import bedrock_state as bs, view_builder, state as _state
    s = _state.load()
    self_name = s.get("node_name", "")
    if target == self_name:
        print(f"ERROR: cannot leave-from-self. Run `bedrock node leave {target}` from another node.")
        return 1
    snapshot = view_builder.rebuild(this_node=self_name)
    target_info = (snapshot.get("nodes") or {}).get(target)
    if not target_info:
        print(f"  {target}: not in cluster snapshot — nothing to do")
        return 0

    # 1. Master writes node_unregister to rqlite. Single-writer
    #    discipline (D-20): only the mgmt master mutates; rqlite
    #    replicates via Raft.
    rev = bs.node_unregister(node_name=target, reason=reason)
    print(f"  rev={rev} node_unregister({target}, reason={reason!r})")

    # 2. Master regenerates its own daemon.toml from the new snapshot
    #    so its peer_sender_ids drops the leaving node immediately.
    _propagate_daemon_config(f"leave:{target}")

    # 3. Best-effort: ask the leaving node to stop its bedrock
    #    services. Failure is non-fatal — the cluster has already
    #    forgotten about it; the leaving node will just stop being
    #    seen at the witness within takeover_threshold.
    target_host = target_info.get("host")
    if target_host:
        import subprocess as _sp
        rc = _sp.run([
            "ssh", "-o", "StrictHostKeyChecking=no",
            "-o", "UserKnownHostsFile=/dev/null",
            "-o", "BatchMode=yes",
            "-o", "ConnectTimeout=5",
            f"root@{target_host}",
            "systemctl stop bedrock-rust bedrock-mgmt 2>/dev/null; "
            "rm -f /tmp/bedrock-rust.fence; "
            "true",
        ]).returncode
        if rc != 0:
            print(f"  warn: SSH stop on {target} returned {rc} (host unreachable; "
                  f"witness will age out the entry naturally)")
        else:
            print(f"  {target}: bedrock services stopped")
    else:
        print(f"  {target}: no host on record — caller must shut it down manually")
    print(f"  cluster reduced to {len(snapshot.get(chr(110)+chr(111)+chr(100)+chr(101)+chr(115), {})) - 1} nodes")
    return 0


def _cmd_node_maint(target: str, mode: str):
    """Toggle a node's maintenance flag in rqlite. Each node's
    orchestrator watches the rqlite revision and re-renders its
    daemon.toml on change — no SSH-fanout, rqlite IS the propagation
    channel.
    """
    from lib import bedrock_state as bs
    on = (mode == "on")
    rev = bs.node_maintenance(node_name=target, on=on)
    print(f"  rev={rev} node_maintenance_set({target}, on={on})")
    print(f"  Rqlite committed; replication propagates to peers.")
    print(f"  Each node's orchestrator regenerates daemon.toml on revision change.")
    print(f"  When you take {target} offline now, surviving nodes won't fence.")


