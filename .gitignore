rust/target
**/*.rs.bk
**/__pycache__/
testbed/images/
testbed/state/

# bedrock-install ISO build artifacts (large + reproducible from build-iso.sh)
installer/iso-build/build/
installer/iso-build/output/
installer/iso-build/payload/

# Large upstream binaries — build-iso.sh re-fetches them at build time
# from pinned upstream URLs. GitHub has a 100 MB per-file limit;
# `weed` (144 MB) and similar live outside git for this reason.
installer/binaries/weed

# Generated deployment tarballs (rebuilt by build-iso/sync; served from S3)
installer/mgmt.tar.gz
installer/bedrock_d.tar.gz
